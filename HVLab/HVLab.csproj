<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformVersion>10.0.19041.0</TargetPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <RootNamespace>HVLab</RootNamespace>
    <AssemblyName>HVLab</AssemblyName>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Unpackaged app (no MSIX): installed by copying the publish folder (see Install.ps1) -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Only ship the languages the app supports (FR/EN) -->
    <SatelliteResourceLanguages>en;fr</SatelliteResourceLanguages>
    <ApplicationIcon>Images\AppIcon.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Self-contained: embed WinUI runtime, no system-wide install required -->
    <!-- Required for PRI generation when building with the dotnet CLI (no Visual Studio) -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Company>HV-LAB</Company>
    <Product>HV-LAB Manager</Product>
    <Description>Gestionnaire Hyper-V — VM, vSwitch, NAT, VHDX</Description>
    <Copyright>Copyright © 2026</Copyright>
  </PropertyGroup>
  <!-- Release: self-contained folder (no single-file: WinUI resources must sit next to the exe,
       and self-extraction would load DLLs from the user's %TEMP% in an elevated process) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>publish\</PublishDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Images\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Post-publish fix-ups for the unpackaged self-contained folder:
       1. dotnet publish omits the compiled XAML (*.xbf) of an unpackaged WinUI app, which then
          crashes natively at startup (0xc0000374) — copy them from the build output.
       2. The Windows App SDK copies ~85 culture folders of WinUI .mui resources that
          SatelliteResourceLanguages does not filter: keep only en-US / fr-FR (en-US is the fallback). -->
  <Target Name="HvlFinalizePublish" AfterTargets="Publish">
    <PropertyGroup>
      <_HvlPublishDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))</_HvlPublishDir>
      <_HvlOutDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(OutDir)'))</_HvlOutDir>
    </PropertyGroup>
    <ItemGroup>
      <_HvlXbf Include="$(_HvlOutDir)**\*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_HvlXbf)"
          DestinationFiles="@(_HvlXbf->'$(_HvlPublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Error Condition="'@(_HvlXbf)' == ''" Text="HV-LAB: no .xbf found in $(_HvlOutDir) — the published app would crash at startup." />
    <ItemGroup>
      <_HvlCultureDir Include="$([System.IO.Directory]::GetDirectories('$(_HvlPublishDir)'))" />
      <_HvlCultureDirToRemove Include="@(_HvlCultureDir)"
          Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)%(Extension)', '^[a-z]{2,3}(-[A-Za-z0-9]+)+$')) and '%(Filename)%(Extension)' != 'en-US' and '%(Filename)%(Extension)' != 'fr-FR'" />
    </ItemGroup>
    <RemoveDir Directories="@(_HvlCultureDirToRemove)" />
    <Message Importance="high" Text="HV-LAB: copied @(_HvlXbf->Count()) .xbf, removed @(_HvlCultureDirToRemove->Count()) unused language folders in $(_HvlPublishDir)" />
  </Target>

</Project>

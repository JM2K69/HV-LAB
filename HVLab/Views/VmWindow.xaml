<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HVLab.Views.VmWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:HVLab.Models"
    xmlns:helpers="using:HVLab.Helpers">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar: drag region with icon + VM name -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Images/Square44x44Logo.png" Width="16" Height="16" VerticalAlignment="Center"/>
            <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"/>
        </Grid>

        <Grid x:Name="BodyGrid" Grid.Row="1" Padding="24,4,24,16" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: name, state, power actions -->
            <Grid x:Name="HeaderGrid" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.Vm.Name, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}"
                               TextTrimming="CharacterEllipsis"/>
                    <Border CornerRadius="12" Padding="10,3" VerticalAlignment="Center"
                            Background="{x:Bind helpers:Display.StateBrush(ViewModel.Vm.State), Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.Vm.State, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                    </Border>
                    <!-- Enhanced session available in the guest (vmconnect: clipboard, sound, any resolution) -->
                    <Border CornerRadius="12" Padding="10,3" VerticalAlignment="Center"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Visibility="{x:Bind ViewModel.Vm.EnhancedSessionReady, Mode=OneWay}"
                            ToolTipService.ToolTip="{Binding [VMW_EnhancedTip], Source={StaticResource Loc}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7F4;" FontSize="12" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                            <TextBlock Text="{Binding [VMW_Enhanced], Source={StaticResource Loc}}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Command="{x:Bind ViewModel.StartCommand}" IsEnabled="{x:Bind ViewModel.Vm.CanStart, Mode=OneWay}"
                            ToolTipService.ToolTip="{Binding [VM_TipStart], Source={StaticResource Loc}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="14"/>
                            <TextBlock Text="{Binding [VM_BulkStart], Source={StaticResource Loc}}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ShutdownCommand}" IsEnabled="{x:Bind ViewModel.Vm.CanStop, Mode=OneWay}"
                            ToolTipService.ToolTip="{Binding [VM_Shutdown], Source={StaticResource Loc}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE71A;" FontSize="14"/>
                            <TextBlock Text="{Binding [VM_BulkStop], Source={StaticResource Loc}}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ConnectCommand}" IsEnabled="{x:Bind ViewModel.Vm.CanConnect, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8A7;" FontSize="14"/>
                            <TextBlock Text="{Binding [VM_TipConsole], Source={StaticResource Loc}}"/>
                        </StackPanel>
                    </Button>
                    <DropDownButton AutomationProperties.Name="{Binding [VM_MoreActions], Source={StaticResource Loc}}"
                                    ToolTipService.ToolTip="{Binding [VM_MoreActions], Source={StaticResource Loc}}">
                        <FontIcon Glyph="&#xE712;" FontSize="14"/>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="{Binding [VM_TurnOff], Source={StaticResource Loc}}" Command="{x:Bind ViewModel.TurnOffCommand}"
                                                IsEnabled="{x:Bind ViewModel.Vm.CanTurnOff, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7E8;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="{Binding [VM_Restart], Source={StaticResource Loc}}" Command="{x:Bind ViewModel.RestartCommand}"
                                                IsEnabled="{x:Bind ViewModel.Vm.CanStop, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE777;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="{Binding [VM_Reset], Source={StaticResource Loc}}" Command="{x:Bind ViewModel.ResetCommand}"
                                                IsEnabled="{x:Bind ViewModel.Vm.CanReset, Mode=OneWay}"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="{Binding [VM_Save], Source={StaticResource Loc}}" Command="{x:Bind ViewModel.SaveCommand}"
                                                IsEnabled="{x:Bind ViewModel.Vm.CanSave, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="{Binding [VM_Pause], Source={StaticResource Loc}}" Command="{x:Bind ViewModel.PauseCommand}"
                                                IsEnabled="{x:Bind ViewModel.Vm.CanPause, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE769;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="{Binding [VM_Resume], Source={StaticResource Loc}}" Command="{x:Bind ViewModel.ResumeCommand}"
                                                IsEnabled="{x:Bind ViewModel.Vm.CanResume, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>
            </Grid>

            <!-- Progress + errors -->
            <StackPanel Grid.Row="1" Spacing="8">
                <ProgressBar IsIndeterminate="True"
                             Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
                <InfoBar Severity="Error" IsClosable="True" CloseButtonCommand="{x:Bind ViewModel.DismissErrorCommand}"
                         IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                         Title="{Binding [Err_Title], Source={StaticResource Loc}}"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button Content="{Binding [Err_CopyDetails], Source={StaticResource Loc}}" Click="CopyErrorDetails_Click"
                                Visibility="{x:Bind ViewModel.HasErrorDetails, Mode=OneWay}"/>
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>

            <Pivot x:Name="Tabs" Grid.Row="2" SelectionChanged="Tabs_SelectionChanged">

                <!-- ═══ Overview: screen on the left, details and credentials on the right ═══ -->
                <PivotItem Header="{Binding [VMW_TabOverview], Source={StaticResource Loc}}">
                    <Grid ColumnSpacing="20" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="360"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" VerticalAlignment="Top">
                            <Grid MinHeight="300">
                                <Image x:Name="ScreenImage" Stretch="Uniform" MaxWidth="1024" MaxHeight="768"
                                       AutomationProperties.Name="{Binding [VMW_Screen], Source={StaticResource Loc}}"/>
                                <TextBlock x:Name="NoScreenText" Text="{Binding [VM_NoScreen], Source={StaticResource Loc}}"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="24"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Column="1">
                            <StackPanel Spacing="12" Padding="0,0,8,0">
                                <!-- Details -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="16,12">
                                    <Grid ColumnSpacing="12" RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding [VM_GuestOs], Source={StaticResource Loc}}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Vm.GuestOs, Mode=OneWay}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="1" Text="{Binding [VM_ColIp], Source={StaticResource Loc}}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Vm.IpAddress, Mode=OneWay}"
                                                   FontFamily="Consolas" IsTextSelectionEnabled="True"/>
                                        <TextBlock Grid.Row="2" Text="{Binding [VM_ColCPU], Source={StaticResource Loc}}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.Vm.CpuDisplay, Mode=OneWay}"/>
                                        <TextBlock Grid.Row="3" Text="{Binding [VM_ColRAM], Source={StaticResource Loc}}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.Vm.MemoryDisplay, Mode=OneWay}"/>
                                        <TextBlock Grid.Row="4" Text="{Binding [VM_Uptime], Source={StaticResource Loc}}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.Vm.Uptime, Mode=OneWay}"/>
                                        <TextBlock Grid.Row="5" Text="{Binding [VM_Heartbeat], Source={StaticResource Loc}}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.Vm.Heartbeat, Mode=OneWay}"/>
                                        <TextBlock Grid.Row="6" Text="{Binding [SW_ColName], Source={StaticResource Loc}}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind ViewModel.Vm.SwitchName, Mode=OneWay}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="7" Text="{Binding [VM_GroupFilter], Source={StaticResource Loc}}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{x:Bind ViewModel.Vm.GroupName, Mode=OneWay}"/>
                                    </Grid>
                                </Border>

                                <!-- Connections -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Click="Ssh_Click" Content="{Binding [VM_Ssh], Source={StaticResource Loc}}"/>
                                    <Button Click="Rdp_Click" Content="{Binding [VM_Rdp], Source={StaticResource Loc}}"/>
                                    <Button Click="CopyIp_Click" Content="{Binding [VM_CopyIp], Source={StaticResource Loc}}"/>
                                </StackPanel>

                                <!-- Credentials written by HV-LAB at creation -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="16,12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding [VM_Credentials], Source={StaticResource Loc}}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="{Binding [VM_NoCredentials], Source={StaticResource Loc}}" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Visibility="{x:Bind helpers:Display.CollapsedWhen(ViewModel.Vm.HasCredentials), Mode=OneWay}"/>
                                        <StackPanel Spacing="8"
                                                    Visibility="{x:Bind ViewModel.Vm.HasCredentials, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind ViewModel.Vm.AccountLine, Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap"/>
                                            <Button Click="CopyPassword_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="12"/>
                                                    <TextBlock Text="{Binding [VM_CopyPassword], Source={StaticResource Loc}}"/>
                                                </StackPanel>
                                            </Button>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Command="{x:Bind ViewModel.TypePasswordCommand}" HorizontalAlignment="Stretch">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE92E;" FontSize="12"/>
                                                        <TextBlock Text="{Binding [VM_TypePassword], Source={StaticResource Loc}}"/>
                                                    </StackPanel>
                                                </Button>
                                                <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.TypingLanguages}"
                                                          SelectedItem="{x:Bind ViewModel.TypingLanguage, Mode=TwoWay}"
                                                          AutomationProperties.Name="{Binding [VM_TypeLayout], Source={StaticResource Loc}}"
                                                          ToolTipService.ToolTip="{Binding [VM_TypeLayout], Source={StaticResource Loc}}"/>
                                            </Grid>
                                        </StackPanel>
                                        <Button Command="{x:Bind ViewModel.SendCtrlAltDelCommand}"
                                                Content="{Binding [VM_SendCtrlAltDel], Source={StaticResource Loc}}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </PivotItem>

                <!-- ═══ Console: live screen at the guest resolution, zoom, keyboard and mouse sent to the VM ═══ -->
                <PivotItem Header="{Binding [VMW_TabConsole], Source={StaticResource Loc}}">
                    <Grid RowSpacing="8" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="ZoomBox" MinWidth="110" ItemsSource="{x:Bind ViewModel.ZoomOptions}"
                                      SelectedIndex="{x:Bind ViewModel.ZoomIndex, Mode=TwoWay}"
                                      AutomationProperties.Name="{Binding [CON_Zoom], Source={StaticResource Loc}}"
                                      ToolTipService.ToolTip="{Binding [CON_Zoom], Source={StaticResource Loc}}"/>
                            <Button Command="{x:Bind ViewModel.SendCtrlAltDelCommand}" IsEnabled="{x:Bind ViewModel.Vm.IsRunning, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE92E;" FontSize="14"/>
                                    <TextBlock Text="{Binding [VM_SendCtrlAltDel], Source={StaticResource Loc}}"/>
                                </StackPanel>
                            </Button>
                            <Button Click="TypeClipboard_Click" IsEnabled="{x:Bind ViewModel.Vm.IsRunning, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE77F;" FontSize="14"/>
                                    <TextBlock Text="{Binding [CON_TypeClipboard], Source={StaticResource Loc}}"/>
                                </StackPanel>
                            </Button>
                            <ComboBox ItemsSource="{x:Bind ViewModel.TypingLanguages}"
                                      SelectedItem="{x:Bind ViewModel.TypingLanguage, Mode=TwoWay}"
                                      AutomationProperties.Name="{Binding [VM_TypeLayout], Source={StaticResource Loc}}"
                                      ToolTipService.ToolTip="{Binding [VM_TypeLayout], Source={StaticResource Loc}}"/>
                            <Button Click="FullScreen_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="FullScreenIcon" Glyph="&#xE740;" FontSize="14"/>
                                    <TextBlock x:Name="FullScreenText" Text="{Binding [CON_FullScreen], Source={StaticResource Loc}}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Focusable surface: while it has the focus, keys and mouse go to the VM (accent border) -->
                        <Border x:Name="ConsoleBorder" Grid.Row="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8" BorderThickness="2" BorderBrush="Transparent">
                            <ContentControl x:Name="ConsoleSurface" IsTabStop="True" UseSystemFocusVisuals="True"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                            AutomationProperties.Name="{Binding [VMW_Screen], Source={StaticResource Loc}}"
                                            PreviewKeyDown="Console_PreviewKeyDown" PreviewKeyUp="Console_PreviewKeyUp"
                                            GotFocus="Console_GotFocus" LostFocus="Console_LostFocus">
                                <Grid>
                                    <ScrollViewer x:Name="ConsoleScroll" ZoomMode="Disabled"
                                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                                                  SizeChanged="ConsoleScroll_SizeChanged">
                                        <Image x:Name="ConsoleImage" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               PointerPressed="ConsoleImage_PointerPressed" PointerReleased="ConsoleImage_PointerReleased"
                                               PointerMoved="ConsoleImage_PointerMoved" PointerWheelChanged="ConsoleImage_PointerWheelChanged"/>
                                    </ScrollViewer>
                                    <TextBlock x:Name="NoConsoleText" Text="{Binding [VM_NoScreen], Source={StaticResource Loc}}"
                                               TextWrapping="Wrap" TextAlignment="Center" Margin="24"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </ContentControl>
                        </Border>

                        <TextBlock x:Name="ConsoleHint" Grid.Row="2" Text="{Binding [CON_Hint], Source={StaticResource Loc}}"
                                   Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </PivotItem>

                <!-- ═══ Checkpoints ═══ -->
                <PivotItem Header="{Binding [VM_Checkpoints], Source={StaticResource Loc}}">
                    <Grid RowSpacing="12" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.CreateCheckpointCommand}" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                    <TextBlock Text="{Binding [CP_Create], Source={StaticResource Loc}}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.ApplyCheckpointCommand}" Content="{Binding [CP_Apply], Source={StaticResource Loc}}"
                                    IsEnabled="{x:Bind ViewModel.HasCheckpointSelection, Mode=OneWay}"/>
                            <Button Command="{x:Bind ViewModel.RenameCheckpointCommand}" Content="{Binding [CP_Rename], Source={StaticResource Loc}}"
                                    IsEnabled="{x:Bind ViewModel.HasCheckpointSelection, Mode=OneWay}"/>
                            <Button Command="{x:Bind ViewModel.RemoveCheckpointCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasCheckpointSelection, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                    <TextBlock Text="{Binding [Btn_Delete], Source={StaticResource Loc}}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Checkpoints}"
                                  SelectedItem="{x:Bind ViewModel.SelectedCheckpoint, Mode=TwoWay}" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:CheckpointRow">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="{x:Bind helpers:CheckpointDisplay.Indent(Indent)}">
                                        <FontIcon Glyph="{x:Bind helpers:CheckpointDisplay.Glyph(IsNow)}" FontSize="14"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{x:Bind helpers:CheckpointDisplay.Name(Name, IsNow)}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind CreatedDisplay}" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Grid.Row="1" Text="{Binding [CP_Empty], Source={StaticResource Loc}}" Margin="4,8"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind ViewModel.HasNoCheckpoints, Mode=OneWay}"/>
                    </Grid>
                </PivotItem>

                <!-- ═══ Settings, edited in place (two columns, no scrolling at the default size) ═══ -->
                <PivotItem Header="{Binding [VMW_TabSettings], Source={StaticResource Loc}}">
                    <ScrollViewer Margin="0,12,0,0">
                        <StackPanel Spacing="14" MaxWidth="760" HorizontalAlignment="Left" Padding="0,0,16,0">
                            <InfoBar Severity="Informational" IsClosable="False"
                                     IsOpen="{x:Bind ViewModel.EditingSettings.IsRunning, Mode=OneWay, FallbackValue=False}"
                                     Message="{Binding [SETVM_Running], Source={StaticResource Loc}}"/>
                            <InfoBar Severity="Error" IsClosable="False"
                                     IsOpen="{x:Bind helpers:Text.IsNotEmpty(ViewModel.SettingsError), Mode=OneWay}"
                                     Message="{x:Bind ViewModel.SettingsError, Mode=OneWay}"/>

                            <Grid ColumnSpacing="20" RowSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding [SETVM_Cpu], Source={StaticResource Loc}}" FontSize="12"/>
                                    <NumberBox Value="{x:Bind ViewModel.EditingSettings.ProcessorCount, Mode=TwoWay, FallbackValue=1}"
                                               Minimum="1" Maximum="64" SpinButtonPlacementMode="Inline"
                                               IsEnabled="{x:Bind ViewModel.EditingSettings.CanEditOffline, Mode=OneWay, FallbackValue=True}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{Binding [SETVM_Nested], Source={StaticResource Loc}}" FontSize="12" TextWrapping="Wrap"/>
                                    <ToggleSwitch IsOn="{x:Bind ViewModel.EditingSettings.Nested, Mode=TwoWay, FallbackValue=False}"
                                                  IsEnabled="{x:Bind ViewModel.EditingSettings.CanEditOffline, Mode=OneWay, FallbackValue=True}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Spacing="4">
                                    <TextBlock Text="{Binding [SETVM_Startup], Source={StaticResource Loc}}" FontSize="12"/>
                                    <NumberBox Value="{x:Bind ViewModel.EditingSettings.StartupMB, Mode=TwoWay, FallbackValue=0}"
                                               Minimum="32" Maximum="1048576" SmallChange="512" LargeChange="1024" SpinButtonPlacementMode="Inline"
                                               IsEnabled="{x:Bind ViewModel.EditingSettings.CanEditOffline, Mode=OneWay, FallbackValue=True}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{Binding [SETVM_Dynamic], Source={StaticResource Loc}}" FontSize="12"/>
                                    <ToggleSwitch IsOn="{x:Bind ViewModel.EditingSettings.DynamicMemory, Mode=TwoWay, FallbackValue=False}"
                                                  IsEnabled="{x:Bind ViewModel.EditingSettings.CanEditOffline, Mode=OneWay, FallbackValue=True}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Spacing="4">
                                    <TextBlock Text="{Binding [SETVM_Min], Source={StaticResource Loc}}" FontSize="12"/>
                                    <NumberBox Value="{x:Bind ViewModel.EditingSettings.MinimumMB, Mode=TwoWay, FallbackValue=0}"
                                               Minimum="32" Maximum="1048576" SmallChange="256" SpinButtonPlacementMode="Inline"
                                               IsEnabled="{x:Bind ViewModel.EditingSettings.DynamicMemory, Mode=OneWay, FallbackValue=True}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{Binding [SETVM_Max], Source={StaticResource Loc}}" FontSize="12"/>
                                    <NumberBox Value="{x:Bind ViewModel.EditingSettings.MaximumMB, Mode=TwoWay, FallbackValue=0}"
                                               Minimum="32" Maximum="1048576" SmallChange="1024" SpinButtonPlacementMode="Inline"
                                               IsEnabled="{x:Bind ViewModel.EditingSettings.DynamicMemory, Mode=OneWay, FallbackValue=True}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="4">
                                    <TextBlock Text="{Binding [SETVM_Iso], Source={StaticResource Loc}}" FontSize="12"/>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{x:Bind ViewModel.EditingSettings.IsoPath, Mode=TwoWay, FallbackValue=''}"
                                                 PlaceholderText="D:\ISO\ubuntu-24.04-live-server-amd64.iso" FontFamily="Consolas" FontSize="12"/>
                                        <Button Grid.Column="1" Click="BrowseIso_Click" Content="{Binding [Btn_Browse], Source={StaticResource Loc}}"/>
                                        <Button Grid.Column="2" Click="EjectIso_Click" Content="{Binding [SETVM_Eject], Source={StaticResource Loc}}"/>
                                    </Grid>
                                </StackPanel>

                                <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding [SETVM_Network], Source={StaticResource Loc}}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0"/>
                                <StackPanel Grid.Row="5" Spacing="4">
                                    <TextBlock Text="{Binding [SETVM_Switch], Source={StaticResource Loc}}" FontSize="12"/>
                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.SwitchNames}"
                                              SelectedItem="{x:Bind ViewModel.EditingSettings.SwitchName, Mode=TwoWay, FallbackValue=''}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="5" Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{Binding [SETVM_VlanMode], Source={StaticResource Loc}}" FontSize="12"/>
                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind models:VmSettings.VlanModes}"
                                              SelectedItem="{x:Bind ViewModel.EditingSettings.VlanMode, Mode=TwoWay, FallbackValue=''}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="6" Spacing="4"
                                            Visibility="{x:Bind ViewModel.EditingSettings.IsAccess, Mode=OneWay, FallbackValue=Collapsed}">
                                    <TextBlock Text="{Binding [SETVM_Vlan], Source={StaticResource Loc}}" FontSize="12"/>
                                    <NumberBox Value="{x:Bind ViewModel.EditingSettings.VlanId, Mode=TwoWay, FallbackValue=0}"
                                               Minimum="1" Maximum="4094" SpinButtonPlacementMode="Inline"/>
                                </StackPanel>
                                <StackPanel Grid.Row="6" Spacing="4"
                                            Visibility="{x:Bind ViewModel.EditingSettings.IsTrunk, Mode=OneWay, FallbackValue=Collapsed}">
                                    <TextBlock Text="{Binding [SETVM_NativeVlan], Source={StaticResource Loc}}" FontSize="12"/>
                                    <NumberBox Value="{x:Bind ViewModel.EditingSettings.NativeVlanId, Mode=TwoWay, FallbackValue=0}"
                                               Minimum="0" Maximum="4094" SpinButtonPlacementMode="Inline"/>
                                </StackPanel>
                                <StackPanel Grid.Row="6" Grid.Column="1" Spacing="4"
                                            Visibility="{x:Bind ViewModel.EditingSettings.IsTrunk, Mode=OneWay, FallbackValue=Collapsed}">
                                    <TextBlock Text="{Binding [SETVM_AllowedVlans], Source={StaticResource Loc}}" FontSize="12"/>
                                    <TextBox Text="{x:Bind ViewModel.EditingSettings.AllowedVlans, Mode=TwoWay, FallbackValue=''}"
                                             PlaceholderText="10,20,100-110" FontFamily="Consolas"/>
                                </StackPanel>
                                <StackPanel Grid.Row="7" Grid.ColumnSpan="2">
                                    <CheckBox Content="{Binding [SETVM_DhcpGuard], Source={StaticResource Loc}}"
                                              IsChecked="{x:Bind ViewModel.EditingSettings.DhcpGuard, Mode=TwoWay, FallbackValue=False}"/>
                                    <CheckBox Content="{Binding [SETVM_RouterGuard], Source={StaticResource Loc}}"
                                              IsChecked="{x:Bind ViewModel.EditingSettings.RouterGuard, Mode=TwoWay, FallbackValue=False}"/>
                                    <CheckBox Content="{Binding [SETVM_MacSpoofing], Source={StaticResource Loc}}"
                                              IsChecked="{x:Bind ViewModel.EditingSettings.MacSpoofing, Mode=TwoWay, FallbackValue=False}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Command="{x:Bind ViewModel.ApplySettingsCommand}" Style="{StaticResource AccentButtonStyle}"
                                        Content="{Binding [SETVM_Apply], Source={StaticResource Loc}}"/>
                                <Button Command="{x:Bind ViewModel.ResetSettingsCommand}"
                                        Content="{Binding [SETVM_Reset], Source={StaticResource Loc}}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
            </Pivot>

            <!-- Status -->
            <TextBlock x:Name="StatusText" Grid.Row="3" Text="{x:Bind ViewModel.Status, Mode=OneWay}" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>
    </Grid>
</Window>

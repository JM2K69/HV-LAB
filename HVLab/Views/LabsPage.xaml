<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HVLab.Views.LabsPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HVLab.ViewModels"
    xmlns:helpers="using:HVLab.Helpers"
    NavigationCacheMode="Required"
    Background="Transparent">

    <!-- Lab blueprints, edited graphically: the JSON file is only the storage -->
    <Grid Padding="36,24,36,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding [LABS_Title], Source={StaticResource Loc}}" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding [LABS_Subtitle], Source={StaticResource Loc}}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <!-- New lab: one of the templates, filled with the host's newest bases -->
            <DropDownButton Grid.Column="1" VerticalAlignment="Center"
                            ToolTipService.ToolTip="{Binding [LABS_NewTip], Source={StaticResource Loc}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                    <TextBlock Text="{Binding [LABS_New], Source={StaticResource Loc}}"/>
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Text="{Binding [LABS_TemplateAdMember], Source={StaticResource Loc}}"
                                        Command="{x:Bind ViewModel.NewLabCommand}" CommandParameter="ad-member"/>
                        <MenuFlyoutItem Text="{Binding [LABS_TemplateAdWeb], Source={StaticResource Loc}}"
                                        Command="{x:Bind ViewModel.NewLabCommand}" CommandParameter="ad-web"/>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <Button Grid.Column="2" VerticalAlignment="Center" Click="OpenFolder_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE838;" FontSize="14"/>
                    <TextBlock Text="{Binding [LABS_OpenFolder], Source={StaticResource Loc}}"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Progress, errors, success -->
        <StackPanel Grid.Row="1" Spacing="8">
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
            <InfoBar Severity="Error" IsClosable="True" CloseButtonCommand="{x:Bind ViewModel.DismissErrorCommand}"
                     IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Title="{Binding [Err_Title], Source={StaticResource Loc}}"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"/>
            <InfoBar Severity="Success" IsClosable="True" CloseButtonCommand="{x:Bind ViewModel.DismissSuccessCommand}"
                     IsOpen="{x:Bind ViewModel.HasSuccess, Mode=OneWay}"
                     Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}"/>
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Blueprints of the folder -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="8,12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding [LABS_Files], Source={StaticResource Loc}}" Margin="8,0"
                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Files}" SelectionMode="Single"
                              SelectedItem="{x:Bind ViewModel.SelectedFile, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding [LABS_Files], Source={StaticResource Loc}}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:LabFile">
                                <StackPanel Padding="0,6">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind Path}"/>
                                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="1" Text="{Binding [LABS_NoFiles], Source={StaticResource Loc}}" Margin="8"
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind helpers:Display.CollapsedWhen(ViewModel.HasFiles), Mode=OneWay}"/>
                </Grid>
            </Border>

            <!-- No lab open -->
            <StackPanel Grid.Column="1" Spacing="12" MaxWidth="380" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.HasNoEditor, Mode=OneWay}">
                <FontIcon Glyph="&#xE81E;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <TextBlock Text="{Binding [LABS_NoEditor], Source={StaticResource Loc}}" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <DropDownButton HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="{Binding [LABS_NewTip], Source={StaticResource Loc}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                        <TextBlock Text="{Binding [LABS_New], Source={StaticResource Loc}}"/>
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="{Binding [LABS_TemplateAdMember], Source={StaticResource Loc}}"
                                            Command="{x:Bind ViewModel.NewLabCommand}" CommandParameter="ad-member"/>
                            <MenuFlyoutItem Text="{Binding [LABS_TemplateAdWeb], Source={StaticResource Loc}}"
                                            Command="{x:Bind ViewModel.NewLabCommand}" CommandParameter="ad-web"/>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>

            <!-- The lab being edited -->
            <ScrollViewer Grid.Column="1" Visibility="{x:Bind ViewModel.HasEditor, Mode=OneWay}">
                <StackPanel Spacing="12" Padding="0,0,16,0">

                    <!-- Lab -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="20,16">
                        <Grid ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.ColumnSpan="2" Text="{Binding [LABS_SecLab], Source={StaticResource Loc}}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBox Grid.Row="1" Header="{Binding [LABS_Name], Source={StaticResource Loc}}"
                                     Text="{x:Bind ViewModel.LabName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="LAB-AD"/>
                            <PasswordBox Grid.Row="1" Grid.Column="1" Header="{Binding [LABS_Password], Source={StaticResource Loc}}"
                                         Password="{x:Bind ViewModel.Password, Mode=TwoWay}"/>
                            <ComboBox Grid.Row="2" Header="{Binding [LABS_Language], Source={StaticResource Loc}}" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.Languages}" SelectedItem="{x:Bind ViewModel.Language, Mode=TwoWay}"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" Header="{Binding [LABS_TimeZone], Source={StaticResource Loc}}" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.TimeZones}" SelectedItem="{x:Bind ViewModel.TimeZone, Mode=TwoWay}"/>
                        </Grid>
                    </Border>

                    <!-- Network -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="20,16">
                        <Grid ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.ColumnSpan="3" Text="{Binding [LABS_SecNetwork], Source={StaticResource Loc}}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <ComboBox Grid.Row="1" Grid.ColumnSpan="3" IsEditable="True" HorizontalAlignment="Stretch"
                                      Header="{Binding [LABS_Switch], Source={StaticResource Loc}}"
                                      ItemsSource="{x:Bind ViewModel.SwitchNames}"
                                      Text="{x:Bind ViewModel.SwitchName, Mode=TwoWay}"/>
                            <ToggleSwitch Grid.Row="2" Header="{Binding [LABS_UseNat], Source={StaticResource Loc}}"
                                          IsOn="{x:Bind ViewModel.UseNat, Mode=TwoWay}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Header="{Binding [LABS_Gateway], Source={StaticResource Loc}}"
                                     Text="{x:Bind ViewModel.NatGateway, Mode=TwoWay}" FontFamily="Consolas" PlaceholderText="192.168.100.1"
                                     Visibility="{x:Bind ViewModel.UseNat, Mode=OneWay}"/>
                            <NumberBox Grid.Row="2" Grid.Column="2" Header="{Binding [LABS_Prefix], Source={StaticResource Loc}}"
                                       Value="{x:Bind ViewModel.NatPrefix, Mode=TwoWay}" Minimum="8" Maximum="30"
                                       SpinButtonPlacementMode="Compact" Visibility="{x:Bind ViewModel.UseNat, Mode=OneWay}"/>
                        </Grid>
                    </Border>

                    <!-- Domain -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="20,16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding [LABS_SecDomain], Source={StaticResource Loc}}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <ToggleSwitch Header="{Binding [LABS_UseDomain], Source={StaticResource Loc}}" IsOn="{x:Bind ViewModel.UseDomain, Mode=TwoWay}"/>
                            <Grid ColumnSpacing="16" RowSpacing="12" Visibility="{x:Bind ViewModel.UseDomain, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBox Header="{Binding [LABS_Domain], Source={StaticResource Loc}}" FontFamily="Consolas"
                                         Text="{x:Bind ViewModel.DomainName, Mode=TwoWay}" PlaceholderText="lab.local"/>
                                <TextBox Grid.Column="1" Header="{Binding [LABS_DomainUser], Source={StaticResource Loc}}" FontFamily="Consolas"
                                         Text="{x:Bind ViewModel.DomainUser, Mode=TwoWay}" PlaceholderText="Administrator"/>
                                <TextBox Grid.Row="1" Grid.ColumnSpan="2" Header="{Binding [LABS_DomainOu], Source={StaticResource Loc}}"
                                         FontFamily="Consolas" Text="{x:Bind ViewModel.DomainOu, Mode=TwoWay}"
                                         PlaceholderText="OU=Servers,DC=lab,DC=local"/>
                            </Grid>
                            <TextBlock Text="{Binding [LABS_DomainHint], Source={StaticResource Loc}}" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind ViewModel.UseDomain, Mode=OneWay}"/>
                        </StackPanel>
                    </Border>

                    <!-- VMs: one card each, in creation order -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="20,16">
                        <StackPanel Spacing="12">
                            <Grid>
                                <TextBlock Text="{Binding [LABS_SecVms], Source={StaticResource Loc}}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           VerticalAlignment="Center"/>
                                <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.AddVmCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                        <TextBlock Text="{Binding [LABS_AddVm], Source={StaticResource Loc}}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding [LABS_VmsHint], Source={StaticResource Loc}}" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Vms}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LabVmRow">
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="12">
                                            <Grid ColumnSpacing="8" RowSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                                </Grid.RowDefinitions>

                                                <!-- Line 1: OS, name, base image, order and removal -->
                                                <FontIcon Glyph="{x:Bind helpers:LabDisplay.OsGlyph(IsLinux), Mode=OneWay}" FontSize="16"
                                                          VerticalAlignment="Bottom" Margin="0,0,0,8"
                                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                <TextBox Grid.Column="1" Grid.ColumnSpan="2" Width="200"
                                                         Header="{Binding [LABS_ColName], Source={StaticResource Loc}}"
                                                         Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <ComboBox Grid.Column="3" Grid.ColumnSpan="2" IsEditable="True" HorizontalAlignment="Stretch"
                                                          Header="{Binding [LABS_ColBase], Source={StaticResource Loc}}"
                                                          ItemsSource="{Binding ViewModel.BasePatterns, ElementName=PageRoot}"
                                                          Text="{x:Bind Base, Mode=TwoWay}"/>
                                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                                    <Button Width="32" Height="32" Padding="0" CommandParameter="{x:Bind}"
                                                            Command="{Binding ViewModel.MoveUpCommand, ElementName=PageRoot}"
                                                            AutomationProperties.Name="{x:Bind helpers:A11y.Action('LABS_MoveUp', Name), Mode=OneWay}"
                                                            ToolTipService.ToolTip="{Binding [LABS_MoveUp], Source={StaticResource Loc}}">
                                                        <FontIcon Glyph="&#xE70E;" FontSize="12"/>
                                                    </Button>
                                                    <Button Width="32" Height="32" Padding="0" CommandParameter="{x:Bind}"
                                                            Command="{Binding ViewModel.MoveDownCommand, ElementName=PageRoot}"
                                                            AutomationProperties.Name="{x:Bind helpers:A11y.Action('LABS_MoveDown', Name), Mode=OneWay}"
                                                            ToolTipService.ToolTip="{Binding [LABS_MoveDown], Source={StaticResource Loc}}">
                                                        <FontIcon Glyph="&#xE70D;" FontSize="12"/>
                                                    </Button>
                                                    <Button Width="32" Height="32" Padding="0" CommandParameter="{x:Bind}"
                                                            Command="{Binding ViewModel.RemoveVmCommand, ElementName=PageRoot}"
                                                            AutomationProperties.Name="{x:Bind helpers:A11y.Action('LABS_RemoveVm', Name), Mode=OneWay}"
                                                            ToolTipService.ToolTip="{Binding [LABS_RemoveVm], Source={StaticResource Loc}}">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                                    </Button>
                                                </StackPanel>

                                                <!-- Line 2: size, address, domain (Windows) or user (Linux) -->
                                                <NumberBox Grid.Row="1" Grid.Column="1" Width="110"
                                                           Header="{Binding [LABS_ColRam], Source={StaticResource Loc}}"
                                                           Value="{x:Bind MemoryMB, Mode=TwoWay}" Minimum="512" Maximum="1048576"
                                                           SmallChange="512" LargeChange="2048" SpinButtonPlacementMode="Compact"/>
                                                <NumberBox Grid.Row="1" Grid.Column="2" Width="82"
                                                           Header="{Binding [LABS_ColCpu], Source={StaticResource Loc}}"
                                                           Value="{x:Bind Cpu, Mode=TwoWay}" Minimum="1" Maximum="64" SpinButtonPlacementMode="Compact"/>
                                                <TextBox Grid.Row="1" Grid.Column="3" Width="130" FontFamily="Consolas"
                                                         Header="{Binding [LABS_ColIp], Source={StaticResource Loc}}"
                                                         Text="{x:Bind Ip, Mode=TwoWay}" PlaceholderText="192.168.100.10"/>
                                                <TextBox Grid.Row="1" Grid.Column="4" FontFamily="Consolas" MinWidth="120"
                                                         Header="{Binding [LABS_ColDns], Source={StaticResource Loc}}"
                                                         Text="{x:Bind Dns, Mode=TwoWay}" PlaceholderText="192.168.100.1"/>
                                                <Grid Grid.Row="1" Grid.Column="5" Width="120">
                                                    <StackPanel VerticalAlignment="Bottom" Visibility="{x:Bind IsWindows, Mode=OneWay}">
                                                        <CheckBox Content="{Binding [LABS_ColDc], Source={StaticResource Loc}}"
                                                                  IsChecked="{x:Bind DomainController, Mode=TwoWay}" IsEnabled="{x:Bind CanBeDc, Mode=OneWay}"
                                                                  ToolTipService.ToolTip="{Binding [LABS_DcTip], Source={StaticResource Loc}}"/>
                                                        <CheckBox Content="{Binding [LABS_ColJoin], Source={StaticResource Loc}}"
                                                                  IsChecked="{x:Bind Join, Mode=TwoWay}" IsEnabled="{x:Bind CanJoin, Mode=OneWay}"/>
                                                    </StackPanel>
                                                    <TextBox Header="{Binding [LABS_ColUser], Source={StaticResource Loc}}" FontFamily="Consolas"
                                                             Text="{x:Bind User, Mode=TwoWay}" Visibility="{x:Bind IsLinux, Mode=OneWay}"/>
                                                </Grid>

                                                <!-- Line 3: tags, written into the VM notes -->
                                                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4"
                                                         Header="{Binding [LABS_ColTags], Source={StaticResource Loc}}"
                                                         Text="{x:Bind Tags, Mode=TwoWay}" PlaceholderText="web, prod"/>

                                                <!-- Line 4 (Linux): first-boot commands, cloud-init runcmd -->
                                                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4"
                                                         Header="{Binding [CVM_LinuxCommands], Source={StaticResource Loc}}"
                                                         ToolTipService.ToolTip="{Binding [CVM_LinuxCommandsTip], Source={StaticResource Loc}}"
                                                         Text="{x:Bind Commands, Mode=TwoWay}" Visibility="{x:Bind IsLinux, Mode=OneWay}"
                                                         AcceptsReturn="True" TextWrapping="NoWrap" Height="96"
                                                         FontFamily="Consolas" FontSize="12"
                                                         PlaceholderText="dnf -y install nginx&#x0a;systemctl enable --now nginx"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Plan: what a deployment would do on this host -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="20,16">
                        <StackPanel Spacing="12">
                            <Grid>
                                <TextBlock Text="{Binding [LABS_SecPlan], Source={StaticResource Loc}}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           VerticalAlignment="Center"/>
                                <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.CheckPlanCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE9D5;" FontSize="12"/>
                                        <TextBlock Text="{Binding [LABS_CheckPlan], Source={StaticResource Loc}}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding [LABS_PlanHint], Source={StaticResource Loc}}" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind helpers:Display.CollapsedWhen(ViewModel.HasPlan), Mode=OneWay}"/>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Plan}" Visibility="{x:Bind ViewModel.HasPlan, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LabPlanRow">
                                        <Grid ColumnSpacing="12" Padding="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{x:Bind helpers:LabDisplay.PlanGlyph(Action)}" FontSize="14"
                                                      Foreground="{x:Bind helpers:LabDisplay.PlanBrush(Action)}"
                                                      ToolTipService.ToolTip="{x:Bind helpers:LabDisplay.PlanText(Action)}"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind helpers:LabDisplay.PlanText(Action)}"
                                                       Foreground="{x:Bind helpers:LabDisplay.PlanBrush(Action)}"/>
                                            <TextBlock Grid.Column="2" FontWeight="SemiBold">
                                                <Run Text="{x:Bind Kind}"/> <Run Text="{x:Bind Name}"/>
                                            </TextBlock>
                                            <TextBlock Grid.Column="3" Text="{x:Bind Detail}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       ToolTipService.ToolTip="{x:Bind Detail}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- The JSON the form generates (what Save writes), live -->
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Header="{Binding [LABS_JsonPreview], Source={StaticResource Loc}}">
                        <TextBox Text="{x:Bind ViewModel.JsonPreview, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                 FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" MaxHeight="360"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="{Binding [LABS_JsonPreview], Source={StaticResource Loc}}"/>
                    </Expander>

                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,8">
                        <Button Command="{x:Bind ViewModel.SaveCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                                <TextBlock Text="{Binding [LABS_Save], Source={StaticResource Loc}}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.DeployCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14"/>
                                <TextBlock Text="{Binding [LABS_Deploy], Source={StaticResource Loc}}"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OpenJson_Click" Content="{Binding [LABS_OpenJson], Source={StaticResource Loc}}"
                                IsEnabled="{x:Bind ViewModel.HasPath, Mode=OneWay}"/>
                        <Button Command="{x:Bind ViewModel.DeleteLabCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                <TextBlock Text="{Binding [LABS_Delete], Source={StaticResource Loc}}"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding [LABS_Unsaved], Source={StaticResource Loc}}" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   Visibility="{x:Bind ViewModel.IsDirty, Mode=OneWay}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.Status, Mode=OneWay}" FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HVLab.Views.VirtualMachinesPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:HVLab.Models"
    xmlns:helpers="using:HVLab.Helpers"
    Background="Transparent">

    <!-- No outer ScrollViewer: the ListView scrolls itself (keeps virtualization and a fixed header) -->
    <Grid Padding="36,24,36,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="{Binding [VM_Title], Source={StaticResource Loc}}" FontSize="28" FontWeight="SemiBold"/>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.ReloadCommand}"
                    ToolTipService.ToolTip="F5">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5"/>
                </Button.KeyboardAccelerators>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                    <TextBlock Text="{Binding [Btn_Refresh], Source={StaticResource Loc}}"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Progress + errors -->
        <StackPanel Grid.Row="1" Spacing="8">
            <ProgressBar IsIndeterminate="True"
                         Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay,
                                       Converter={StaticResource BoolToVisibilityConverter}}"/>
            <InfoBar Severity="Error"
                     IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     IsClosable="False"
                     Title="{Binding [Err_Title], Source={StaticResource Loc}}"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"/>
        </StackPanel>

        <!-- Column headers -->
        <Grid Grid.Row="2"
              Background="{ThemeResource SubtleFillColorSecondaryBrush}"
              Padding="16,8" CornerRadius="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="55"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding [VM_ColName], Source={StaticResource Loc}}"    FontWeight="SemiBold" FontSize="12"/>
            <TextBlock Grid.Column="1" Text="{Binding [VM_ColState], Source={StaticResource Loc}}"   FontWeight="SemiBold" FontSize="12"/>
            <TextBlock Grid.Column="2" Text="{Binding [VM_ColGen], Source={StaticResource Loc}}"     FontWeight="SemiBold" FontSize="12"/>
            <TextBlock Grid.Column="3" Text="{Binding [VM_ColRAM], Source={StaticResource Loc}}"     FontWeight="SemiBold" FontSize="12"/>
            <TextBlock Grid.Column="4" Text="{Binding [VM_ColCPU], Source={StaticResource Loc}}"     FontWeight="SemiBold" FontSize="12"/>
            <TextBlock Grid.Column="5" Text="{Binding [SW_ColName], Source={StaticResource Loc}}"    FontWeight="SemiBold" FontSize="12"/>
            <TextBlock Grid.Column="6" Text="{Binding [VM_ColVlan], Source={StaticResource Loc}}"    FontWeight="SemiBold" FontSize="12"/>
            <TextBlock Grid.Column="7" Text="{Binding [VM_ColActions], Source={StaticResource Loc}}" FontWeight="SemiBold" FontSize="12"/>
        </Grid>

        <!-- VM list -->
        <ListView Grid.Row="3"
                  ItemsSource="{x:Bind ViewModel.VirtualMachines, Mode=OneWay}"
                  SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding"                    Value="16,0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="MinHeight"                  Value="48"/>
                    <Setter Property="CornerRadius"               Value="6"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:VirtualMachine">
                    <Grid ColumnSpacing="8" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <!-- Nom -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7F8;" FontSize="14"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" FontWeight="Medium"
                                       ToolTipService.ToolTip="{x:Bind Name}"/>
                        </StackPanel>

                        <!-- État avec badge coloré -->
                        <Border Grid.Column="1" CornerRadius="12"
                                HorizontalAlignment="Left" Padding="10,3"
                                VerticalAlignment="Center"
                                Background="{x:Bind State, Mode=OneWay, Converter={StaticResource StateToColorConverter}}">
                            <TextBlock Text="{x:Bind State, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="White"/>
                        </Border>

                        <TextBlock Grid.Column="2" Text="{x:Bind GenDisplay}"
                                   VerticalAlignment="Center" FontSize="13"/>
                        <TextBlock Grid.Column="3" Text="{x:Bind MemoryDisplay, Mode=OneWay}"
                                   VerticalAlignment="Center" FontSize="13"/>
                        <TextBlock Grid.Column="4" Text="{x:Bind ProcessorCount, Mode=OneWay}"
                                   VerticalAlignment="Center" FontSize="13"/>
                        <TextBlock Grid.Column="5" Text="{x:Bind SwitchName, Mode=OneWay}"
                                   VerticalAlignment="Center" FontSize="13"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="6" Text="{x:Bind VlanInfo, Mode=OneWay}"
                                   VerticalAlignment="Center" FontSize="13"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind VlanInfo, Mode=OneWay}"/>

                        <!-- Actions -->
                        <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="4"
                                    VerticalAlignment="Center">
                            <Button Command="{Binding ViewModel.StartVmCommand, ElementName=PageRoot}" CommandParameter="{x:Bind}"
                                    Width="32" Height="32" Padding="0"
                                    IsEnabled="{x:Bind CanStart, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind helpers:A11y.Action('VM_TipStart', Name)}"
                                    ToolTipService.ToolTip="{Binding [VM_TipStart], Source={StaticResource Loc}}">
                                <FontIcon Glyph="&#xE768;" FontSize="12"/>
                            </Button>
                            <Button Command="{Binding ViewModel.StopVmCommand, ElementName=PageRoot}" CommandParameter="{x:Bind}"
                                    Width="32" Height="32" Padding="0"
                                    IsEnabled="{x:Bind CanStop, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind helpers:A11y.Action('VM_TipStop', Name)}"
                                    ToolTipService.ToolTip="{Binding [VM_TipStop], Source={StaticResource Loc}}">
                                <FontIcon Glyph="&#xE71A;" FontSize="12"/>
                            </Button>
                            <Button Command="{Binding ViewModel.ConnectVmCommand, ElementName=PageRoot}" CommandParameter="{x:Bind}"
                                    Width="32" Height="32" Padding="0"
                                    IsEnabled="{x:Bind CanConnect, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind helpers:A11y.Action('VM_TipConsole', Name)}"
                                    ToolTipService.ToolTip="{Binding [VM_TipConsole], Source={StaticResource Loc}}">
                                <FontIcon Glyph="&#xE8A7;" FontSize="12"/>
                            </Button>
                            <Button Command="{Binding ViewModel.RemoveVmCommand, ElementName=PageRoot}" CommandParameter="{x:Bind}"
                                    Width="32" Height="32" Padding="0"
                                    IsEnabled="{x:Bind CanRemove, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind helpers:A11y.Action('Btn_Delete', Name)}"
                                    ToolTipService.ToolTip="{Binding [Btn_Delete], Source={StaticResource Loc}}">
                                <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty state -->
        <StackPanel Grid.Row="3" Spacing="12" MaxWidth="360"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay,
                                 Converter={StaticResource BoolToVisibilityConverter}}">
            <FontIcon Glyph="&#xE7F8;" FontSize="48"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            <TextBlock Text="{Binding [VM_EmptyTitle], Source={StaticResource Loc}}"
                       FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding [VM_EmptyText], Source={StaticResource Loc}}"
                       TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center"
                    Click="CreateVm_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE945;" FontSize="14"/>
                    <TextBlock Text="{Binding [VM_EmptyButton], Source={StaticResource Loc}}"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Status bar -->
        <TextBlock Grid.Row="4"
                   Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                   FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Margin="0,4,0,0"/>
    </Grid>
</Page>
